local trackedEntities = {}

local function removeVisuals(entityKey)
    if trackedEntities[entityKey] then
        if trackedEntities[entityKey].connections then
            for _, conn in ipairs(trackedEntities[entityKey].connections) do
                conn:Disconnect()
            end
        end
        if trackedEntities[entityKey].highlight then
            trackedEntities[entityKey].highlight:Destroy()
        end
        if trackedEntities[entityKey].billboard then
            trackedEntities[entityKey].billboard:Destroy()
        end
        trackedEntities[entityKey] = nil
    end
end

local function updatePlayerVisuals(player, data)
    if not playerEspEnabled then return end
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local rootPart = character and (character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso"))

    if character and humanoid and rootPart and humanoid.Health > 0 then
        data.highlight.Adornee = character
        data.billboard.Adornee = rootPart

        local health = humanoid.Health
        local fillColor, statusText, statusColor

        if health <= 200 then
            fillColor = Color3.fromRGB(0, 255, 0)
            statusText = "Survivor"
            statusColor = Color3.fromRGB(0, 255, 0)
        elseif health >= 320 then
            fillColor = Color3.fromRGB(255, 0, 0)
            statusText = "Killer"
            statusColor = Color3.fromRGB(255, 0, 0)
        else
            fillColor = Color3.fromRGB(200, 200, 200)
            statusText = ""
            statusColor = Color3.fromRGB(255, 255, 255)
        end

        data.highlight.FillColor = fillColor
        data.nameLabel.Text = player.Name .. " [" .. math.floor(health) .. "HP]"
        data.statusLabel.Text = statusText
        data.statusLabel.TextColor3 = statusColor

        data.billboard.Enabled = true
        data.highlight.Enabled = true
    else
        data.highlight.Adornee = nil
        data.billboard.Adornee = nil
        data.billboard.Enabled = false
        data.highlight.Enabled = false
    end
end

