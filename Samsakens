local function evaluateObject(obj)
    if not playerEspEnabled or not obj or trackedEntities[obj] then return end

    if obj:IsA("Model") then
        if targetModels[obj.Name] then
            local config = targetModels[obj.Name]
            setupModelVisuals(obj, config.displayName, config.color, config.nametag)
        elseif obj.Parent and obj.Parent:IsA("Folder") and isShadowsFolder(obj.Parent.Name) then
            setupModelVisuals(obj, obj.Name, Color3.fromRGB(0, 0, 0), true)
        elseif obj.Name == "Shadow" or obj.Name == "Trail" then
            setupModelVisuals(obj, obj.Name, Color3.fromRGB(0, 0, 0), true)
        end
    elseif obj:IsA("Folder") and isShadowsFolder(obj.Name) then
        for _, child in ipairs(obj:GetChildren()) do
            if child:IsA("Model") then
                setupModelVisuals(child, child.Name, Color3.fromRGB(0, 0, 0), true)
            end
        end
    end
end

local function scanWorkspacePlayers()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        evaluateObject(obj)
    end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            setupPlayerVisuals(player)
        end
    end
end

