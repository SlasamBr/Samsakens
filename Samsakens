local aimbotEnabled = false
local aimbotPart = "Head"
local aimbotFov = 150

local function getBestTarget()
    local bestTarget = nil
    local highestHealth = -1
    local shortestDistance = aimbotFov
    local mouseLocation = UserInputService:GetMouseLocation()

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local targetChar = player.Character
            local targetHum = targetChar:FindFirstChildOfClass("Humanoid")
            local targetPart = targetChar:FindFirstChild(aimbotPart) or targetChar:FindFirstChild("HumanoidRootPart")

            if targetHum and targetHum.Health > 0 and targetPart then
                local screenPoint, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                if onScreen then
                    local distanceToMouse = (Vector2.new(screenPoint.X, screenPoint.Y) - mouseLocation).Magnitude
                    if distanceToMouse < shortestDistance then
                        if targetHum.Health > highestHealth then
                            highestHealth = targetHum.Health
                            shortestDistance = distanceToMouse
                            bestTarget = targetPart
                        end
                    end
                end
            end
        end
    end

    return bestTarget
end

RunService.RenderStepped:Connect(function()
    if not aimbotEnabled then return end

    local targetPart = getBestTarget()
    if targetPart then
        Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, targetPart.Position)
    end
end)

