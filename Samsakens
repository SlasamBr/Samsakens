local puzzleGuiVisible = false
local puzzleScreenGui = nil
local isCooldown = false
local cooldownTime = 1.5

local function DoGenPuzzle()
	local allowedPlaceIds = {
		18687417158,
		83645629621104,
		94626476208514,
		86454545238517
	}
	
	if table.find(allowedPlaceIds, game.PlaceId) then
		pcall(function()
			local map = workspace:FindFirstChild("Map")
			if not map then return end
			local ingame = map:FindFirstChild("Ingame")
			if not ingame then return end
			local mapFolder = ingame:FindFirstChild("Map")
			if not mapFolder then return end
			
			for _, child in ipairs(mapFolder:GetChildren()) do
				local remotes = child:FindFirstChild("Remotes")
				if remotes then
					local re = remotes:FindFirstChild("RE")
					if re and re:IsA("RemoteEvent") then
						re:FireServer()
					end
				end
			end
		end)
	end
end

local function togglePuzzleGui(state)
    puzzleGuiVisible = state
    if state then
        if puzzleScreenGui then pcall(function() puzzleScreenGui:Destroy() end) end
        
        puzzleScreenGui = Instance.new("ScreenGui")
        puzzleScreenGui.Name = "ForsakenPuzzleGui"
        puzzleScreenGui.Parent = CoreGui
        puzzleScreenGui.ResetOnSpawn = false

        local MainFrame = Instance.new("Frame")
        MainFrame.Name = "MainFrame"
        MainFrame.Parent = puzzleScreenGui
        MainFrame.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
        MainFrame.Position = UDim2.new(0.1, 0, 0.1, 0)
        MainFrame.Size = UDim2.new(0, 180, 0, 70)
        MainFrame.Active = true
        MainFrame.Draggable = true

        local UICorner = Instance.new("UICorner")
        UICorner.CornerRadius = UDim.new(0, 8)
        UICorner.Parent = MainFrame

        local SolveButton = Instance.new("TextButton")
        SolveButton.Name = "SolveButton"
        SolveButton.Parent = MainFrame
        SolveButton.BackgroundColor3 = Color3.fromRGB(50, 150, 50)
        SolveButton.Position = UDim2.new(0, 10, 0, 10)
        SolveButton.Size = UDim2.new(0, 160, 0, 50)
        SolveButton.Font = Enum.Font.SourceSansBold
        SolveButton.Text = "Do One Gen Puzzle"
        SolveButton.TextColor3 = Color3.fromRGB(255, 255, 255)
        SolveButton.TextSize = 16

        local ButtonCorner = Instance.new("UICorner")
        ButtonCorner.CornerRadius = UDim.new(0, 6)
        ButtonCorner.Parent = SolveButton

        SolveButton.MouseButton1Click:Connect(function()
            if isCooldown then return end
            isCooldown = true
            
            DoGenPuzzle()
            
            local timeLeft = cooldownTime
            while timeLeft > 0 do
                SolveButton.Text = string.format("%.1fs", timeLeft)
                task.wait(0.1)
                timeLeft = timeLeft - 0.1
            end
            
            SolveButton.Text = "Do One Gen Puzzle"
            isCooldown = false
        end)
    else
        if puzzleScreenGui then
            pcall(function() puzzleScreenGui:Destroy() end)
            puzzleScreenGui = nil
        end
    end
end

