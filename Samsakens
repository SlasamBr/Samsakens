        task.defer(function()
            if playerEspEnabled then
                updatePlayerVisuals(player, data)
            end
            local humanoid = character:WaitForChild("Humanoid", 5)
            if humanoid then
                local healthConn = humanoid:GetPropertyChangedSignal("Health"):Connect(function()
                    if playerEspEnabled then
                        updatePlayerVisuals(player, data)
                    end
                end)
                table.insert(data.connections, healthConn)
            end
        end)
    end

    local charConn = player.CharacterAdded:Connect(hookCharacter)
    table.insert(data.connections, charConn)

    if player.Character then
        hookCharacter(player.Character)
    end
end

