local itemEspEnabled = false
local ESP_CONFIG = {
    TargetNames = {
        ["BloxyCola"] = Color3.fromRGB(255, 50, 50),
        ["Medkit"]    = Color3.fromRGB(50, 255, 50)
    },
    TextSize = 14,
    MaxDistance = 400
}

local activeESP = {}

local function removeESP(item)
    local data = activeESP[item]
    if data then
        if data.Highlight then 
            pcall(function() data.Highlight:Destroy() end)
        end
        if data.Text then 
            pcall(function() data.Text:Remove() end)
        end
        activeESP[item] = nil
    end
end

local function createESP(item, itemName)
    if not itemEspEnabled or activeESP[item] then return end
    
    local success, highlight = pcall(function()
        local h = Instance.new("Highlight")
        h.Name = "ForsakenESP_Highlight"
        h.Adornee = item
        h.FillColor = ESP_CONFIG.TargetNames[itemName]
        h.OutlineColor = Color3.fromRGB(255, 255, 255)
        h.FillTransparency = 0.2
        h.OutlineTransparency = 0
        h.Parent = item
        return h
    end)

    if not success then return end

    local textDrawing = Drawing.new("Text")
    textDrawing.Visible = false
    textDrawing.Center = true
    textDrawing.Outline = true
    textDrawing.Font = Drawing.Fonts.UI
    textDrawing.Size = ESP_CONFIG.TextSize
    textDrawing.Color = ESP_CONFIG.TargetNames[itemName]
    textDrawing.Text = "[" .. itemName .. "]"

    local part = nil
    if item:IsA("Model") then
        part = item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart")
    elseif item:IsA("BasePart") then
        part = item
    end

    if not part then
        highlight:Destroy()
        textDrawing:Remove()
        return
    end

    activeESP[item] = {
        Highlight = highlight,
        Text = textDrawing,
        Part = part,
        Name = itemName
    }
end

local function scanWorkspaceItems()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if ESP_CONFIG.TargetNames[obj.Name] then
            if obj:IsA("Model") or obj:IsA("BasePart") then
                createESP(obj, obj.Name)
            end
        end
    end
end

Workspace.DescendantAdded:Connect(function(obj)
    if itemEspEnabled and ESP_CONFIG.TargetNames[obj.Name] then
        task.delay(0.1, function()
            if obj and obj.Parent and (obj:IsA("Model") or obj:IsA("BasePart")) then
                createESP(obj, obj.Name)
            end
        end)
    end
end)

Workspace.DescendantRemoving:Connect(function(obj)
    if activeESP[obj] then
        removeESP(obj)
    end
end)

RunService.RenderStepped:Connect(function()
    if not itemEspEnabled then return end
    local character = LocalPlayer.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    
    for item, data in pairs(activeESP) do
        local part = data.Part
        if not item or not item.Parent or not part or not part.Parent or part.Transparency >= 1 then
            removeESP(item)
        else
            if rootPart then
                local pos = part.Position
                local distance = (pos - rootPart.Position).Magnitude
                
                if distance <= ESP_CONFIG.MaxDistance then
                    local vector, onScreen = Camera:WorldToViewportPoint(pos)
                    if onScreen then
                        data.Text.Position = Vector2.new(vector.X, vector.Y)
                        data.Text.Visible = true
                    else
                        data.Text.Visible = false
                    end
                else
                    data.Text.Visible = false
                end
            else
                data.Text.Visible = false
            end
        end
    end
end)

