local generatorEspEnabled = false
local COLOR_PURPLE = Color3.fromRGB(128, 0, 128)
local COLOR_YELLOW = Color3.fromRGB(255, 255, 0)

local function createHighlightGen(model, color)
    if model:FindFirstChild("ESP_Highlight") then
        model.ESP_Highlight:Destroy()
    end
    
    local highlight = Instance.new("Highlight")
    highlight.Name = "ESP_Highlight"
    highlight.Adornee = model
    highlight.FillColor = color
    highlight.OutlineColor = color
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0
    highlight.Parent = model
end

local function checkAndApplyGen(item)
    if not generatorEspEnabled then return end
    if not (item:IsA("Model") or item:IsA("BasePart")) then return end
    
    local nameLower = item.Name:lower()
    local targetColor = nil
    
    if nameLower == "fakegenerator" then
        targetColor = COLOR_PURPLE
    elseif nameLower == "generator" or nameLower == "generators" then
        targetColor = COLOR_YELLOW
    end
    
    if targetColor then
        createHighlightGen(item, targetColor)
    end
end

local function clearAllGenerators()
    for _, v in ipairs(Workspace:GetDescendants()) do
        if v.Name == "ESP_Highlight" and v.Parent then
            local nameLower = v.Parent.Name:lower()
            if nameLower == "fakegenerator" or nameLower == "generator" or nameLower == "generators" then
                v:Destroy()
            end
        end
    end
end

local function scanGenerators()
    clearAllGenerators()
    for _, child in ipairs(Workspace:GetDescendants()) do
        checkAndApplyGen(child)
    end
end

Workspace.DescendantAdded:Connect(function(child)
    if generatorEspEnabled then
        task.defer(function()
            if child and child.Parent then
                checkAndApplyGen(child)
            end
        end)
    end
end)

